# Locato Web Client Environment Configuration
# NOTE: All VITE_ variables are embedded in the public client bundle at build time.
# NEVER place sensitive API keys, private credentials, or server secrets here!

# Production API Endpoint (e.g., deployed on Render)
VITE_API_URL=https://locato-api.onrender.com/api/v1

# Optional Dedicated Socket.IO Endpoint (defaults to VITE_API_URL hostname if omitted)
VITE_SOCKET_URL=https://locato-api.onrender.com

