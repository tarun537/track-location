# Server Configuration
PORT=5000
NODE_ENV=development
API_URL=http://localhost:5000

# Client Configuration & CORS
CLIENT_ORIGIN=http://localhost:5173

# Database Configuration (MongoDB Atlas connection string)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/locato_dev

# Security & Tokens
# Pepper salt used in token hashing (optional secondary layer)
TOKEN_SALT=change_this_to_a_secure_random_string_in_production

# Logging
LOG_LEVEL=info

